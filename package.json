{
  "name": "dedup-contacts",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "test": "npm run test --workspace server",
    "test:watch": "npm run test:watch --workspace server",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace client"
  },
  "devDependencies": {
    "@types/jaro-winkler": "^0.2.4",
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "jaro-winkler": "^0.2.8"
  }
}
